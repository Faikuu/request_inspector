# Copy to backend/.env and edit. Every variable is optional except as noted.
# Variables are read with the RI_ prefix.

# Signs viewer tokens. Strongly recommended: at least 32 random characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random key is generated on each start and every viewer session ends on restart.
RI_SECRET_KEY=

# SQLite (default, no setup needed). The file is created in the backend/ directory.
RI_DATABASE_URL=sqlite+aiosqlite:///./request_inspector.db

# PostgreSQL alternative. Needs the asyncpg driver (already in requirements.txt).
# RI_DATABASE_URL=postgresql+asyncpg://request_inspector:CHANGE_ME@127.0.0.1:5432/request_inspector

# Comma-separated browser origins allowed to open the live stream and call the API cross-origin.
# Same-origin deployments do not need to list their own origin.
RI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Lifetime of a viewer token, in minutes. Expired tokens close the live stream.
RI_TOKEN_TTL_MINUTES=60

# Largest request body a capture URL accepts, in bytes. Larger requests get 413.
RI_MAX_BODY_BYTES=1048576

# Oldest requests are pruned once an inbox holds more than this many.
RI_MAX_REQUESTS_PER_INBOX=500

# Password attempts per client IP per minute (POST /api/inboxes/{id}/session).
RI_SESSION_ATTEMPTS_PER_MINUTE=10

# Password attempts per inbox per minute, across all clients.
RI_INBOX_SESSION_ATTEMPTS_PER_MINUTE=30

# Inbox creations per client IP per hour.
RI_INBOX_CREATES_PER_HOUR=30

# Captured requests per inbox per minute. Extra requests get 429.
RI_HOOK_REQUESTS_PER_MINUTE=300

# Set to true only behind a reverse proxy that overwrites X-Forwarded-For.
# When false, the socket address is recorded as remote_addr.
RI_TRUST_PROXY_HEADERS=false

# Log every SQL statement. Development only.
RI_SQL_ECHO=false

# Serve the interactive API docs at /docs, /redoc and /openapi.json.
RI_ENABLE_DOCS=false

# docker-compose.yml (repo root) reads POSTGRES_* from a .env file in the repo root, not this file:
#   POSTGRES_PASSWORD=choose-a-password
#   POSTGRES_USER=request_inspector      (optional)
#   POSTGRES_DB=request_inspector        (optional)
